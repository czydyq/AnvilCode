# AnvilCode 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
ANVIL_HOST=127.0.0.1
ANVIL_PORT=7437

# ── Logging ───────────────────────────────────────────────────
ANVIL_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
ANVIL_LOG_FILE=~/.anvil/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
ANVIL_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# ANVIL_CONFIG=~/.anvil/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANVIL_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# ANVIL_MAX_STEPS=20
